# HTTPS automático (Let's Encrypt) para la API. Sin directiva `log`: Caddy no escribe log
# de accesos (ni IPs, ni rutas, ni cabeceras); solo sus propios eventos (certificados).
{
	# Solo HTTP/1.1 y HTTP/2: ufw no abre 443/UDP (HTTP/3).
	servers {
		protocols h1 h2
	}
}

api.pdfcadabra.com {
	# Algo por encima de los 25 MB (20 del archivo + 5 de margen del multipart) que la API
	# admite en el Content-Length, para que el 413 lo dé la API (en JSON y con cabeceras
	# CORS) y no Caddy.
	request_body {
		max_size 26MB
	}
	header -Server
	reverse_proxy api:3000
}
