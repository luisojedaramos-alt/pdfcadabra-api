# HTTPS automático (Let's Encrypt) para la API. Sin directiva `log`: Caddy no escribe log
# de accesos (ni IPs, ni rutas, ni cabeceras); solo sus propios eventos (certificados).
{
	# Solo HTTP/1.1 y HTTP/2: ufw no abre 443/UDP (HTTP/3).
	servers {
		protocols h1 h2
	}
}

# Errores que genera Caddy y no la API: 502 si la API no responde (mientras se recrea su
# contenedor en un despliegue, o si se cae) y 413 por encima de max_size. Sin cabeceras CORS la
# web no puede leerlos y los muestra como un fallo de red (estado 0; incidencia del
# 2026-10-15): llevan las mismas que la API para los orígenes de la web, que hay que mantener
# iguales que ALLOWED_ORIGINS (server.js) y EXTRA_ALLOWED_ORIGINS (docker-compose.yml).
(errores_cors) {
	@web header_regexp Origin ^https://(pdfcadabra\.com|www\.pdfcadabra\.com|dev--pdfcadabra\.netlify\.app)$
	header @web {
		Access-Control-Allow-Origin {http.request.header.Origin}
		Access-Control-Expose-Headers Retry-After
	}
	header {
		-Server
		Vary Origin
		Cache-Control no-store
		Content-Type "application/json; charset=utf-8"
	}
}

api.pdfcadabra.com {
	# Algo por encima de los 133 MB (100 del archivo en el plan Pro + 33 de margen del
	# multipart en /v1/redact/apply: la lista de hallazgos, hasta 16 MB) que la API admite
	# en el Content-Length, para que el 413 lo dé la API (en JSON y con cabeceras CORS) y no
	# Caddy. El plan gratuito (50 MB) lo corta la API: por Content-Length sin leer el cuerpo
	# y, sin él, multer al pasar del límite.
	# Sin timeouts de lectura del cuerpo ni de respuesta (los de Caddy por defecto: ninguno;
	# solo 1 min para las cabeceras): los topes de tiempo son los de la API.
	request_body {
		max_size 134MB
	}
	header -Server
	reverse_proxy api:3000

	# Mismo cuerpo que el 413 de la API.
	handle_errors 413 {
		import errores_cors
		respond `{"error":"FILE_TOO_LARGE","message":"El archivo supera el máximo admitido."}` 413
	}
	handle_errors {
		import errores_cors
		header Retry-After 10
		respond `{"code":"SERVICE_UNAVAILABLE","error":"El servicio no está disponible en este momento. Inténtalo de nuevo en unos segundos."}` {err.status_code}
	}
}
